# Qloo API Credentials
QLOO_API_KEY=qloo_live_...

# LLM Orchestration
GROQ_API_KEY=gsk_...

# Application Environment
ENVIRONMENT=production

# Comma-separated browser origins allowed to call the API (configure in Railway)
CORS_ORIGINS=https://your-app.vercel.app

# Gateway Resilience Mode
# live: bypass cache, execute directly against Qloo
# live_cached: write new queries to disk, read existing from disk
# replay: strictly offline, fail if query not in disk cache (Judge fallback)
QLOO_CACHE_MODE=live_cached